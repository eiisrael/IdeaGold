# IdeaGold 2.0
PORT=8080
HOST=127.0.0.1

# Segredo compartilhado entre servidor e worker-agent.js.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKER_SHARED_SECRET=troque-por-um-segredo-forte

# Exchanges liberadas para leitura/cotação.
ALLOWED_EXCHANGES=mercado,kraken

# Trading REAL vem DESLIGADO. Só ative após testar cotações/saldos.
ENABLE_LIVE_TRADING=false
MAX_LIVE_TRADE_BRL=500

# Mercado Bitcoin (CCXT id: mercado)
MERCADO_API_KEY=
MERCADO_SECRET=
MERCADO_UID=
MERCADO_PASSWORD=

# Kraken (CCXT id: kraken)
KRAKEN_API_KEY=
KRAKEN_SECRET=
KRAKEN_UID=
KRAKEN_PASSWORD=

# CoinGecko é keyless por padrão. Opcionalmente informe uma Demo/Pro key.
COINGECKO_API_KEY=

# Worker Agent (copie estas variáveis para cada máquina de mineração)
IDEAGOLD_SERVER=http://127.0.0.1:8080
WORKER_ID=rig-01
WORKER_NAME=Rig Principal
WORKER_COIN=XMR
XMRIG_API=http://127.0.0.1:18080/2/summary
XMRIG_API_TOKEN=
WORKER_INTERVAL_MS=15000

# Opcional: iniciar um XMRig LOCAL já instalado.
# O agente só aceita executável cujo nome seja xmrig ou xmrig.exe.
AUTO_START_XMRIG=false
XMRIG_EXECUTABLE=
XMRIG_CONFIG=
