# IdeaGold 4.0
PORT=8080
HOST=127.0.0.1

# Minerador local. Padrao: build avancado do MoneroOcean com fallback para XMRig oficial.
MINER_ENGINE=moneroocean-advanced
POOL_HOST=gulf.moneroocean.stream
POOL_PORT=20128
WATCHDOG_ENABLED=true

# CoinGecko opcional (sem chave funciona enquanto a API publica permitir).
COINGECKO_API_KEY=

# Workers autorizados / cloud / outro PC.
# Gere um segredo forte:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKER_SHARED_SECRET=troque-por-um-segredo-forte
IDEAGOLD_SERVER=http://127.0.0.1:8080
WORKER_ID=rig-01
WORKER_NAME=Rig Principal
WORKER_COIN=XMR
XMRIG_API=http://127.0.0.1:18080
XMRIG_API_TOKEN=
WORKER_INTERVAL_MS=15000

# Custos do worker para o GoldBrain calcular lucro liquido agregado.
WORKER_POWER_WATTS=0
WORKER_ELECTRICITY_BRL_KWH=0.90
WORKER_CLOUD_COST_BRL_DAY=0

# Opcional: o worker pode iniciar um XMRig que voce ja instalou/configurou localmente.
AUTO_START_XMRIG=false
XMRIG_EXECUTABLE=
XMRIG_CONFIG=
