# IdeaGold 5.0 — local-first
HOST=127.0.0.1
PORT=8080

# Opcional: caminho para XMRig oficial já instalado (principalmente Linux).
# Windows x64 pode instalar a release oficial fixada e verificar checksum.
XMRIG_PATH=

# Dados de mercado. Chave CoinGecko é opcional.
COINGECKO_API_KEY=

# P2Pool opcional. Se não existir, MoneroOcean continua disponível.
P2POOL_DATA_API=

# Sensor local opcional. Deve ser HTTP(S) em localhost e retornar JSON como:
# {"cpuPackageC":65.2,"gpuC":58.0,"powerW":92.4,"cpuClockMHz":3600}
IDEAGOLD_SENSOR_URL=

# Compatibilidade opcional com workers autorizados / GoldMesh.
WORKER_SHARED_SECRET=troque-por-um-segredo-forte
IDEAGOLD_SERVER=http://127.0.0.1:8080
WORKER_ID=rig-01
WORKER_NAME=Rig Principal
WORKER_COIN=XMR
XMRIG_API=http://127.0.0.1:18080
XMRIG_API_TOKEN=
WORKER_INTERVAL_MS=15000
WORKER_POWER_WATTS=0
WORKER_ELECTRICITY_BRL_KWH=0.90
WORKER_CLOUD_COST_BRL_DAY=0
AUTO_START_XMRIG=false
XMRIG_EXECUTABLE=
XMRIG_CONFIG=
