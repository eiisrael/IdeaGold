# IdeaGold 5.0
PORT=8080
HOST=127.0.0.1

# Linux/macOS: a instalação automática do minerador não é feita pela V5.
# Aponte para um XMRig oficial que você verificou.
XMRIG_EXE=

# Workers autorizados legados/opcionais.
# Gere um segredo forte e use o mesmo no worker-agent.js.
WORKER_SHARED_SECRET=troque-por-um-segredo-forte
IDEAGOLD_SERVER=http://127.0.0.1:8080
WORKER_ID=rig-01
WORKER_NAME=Rig Principal
XMRIG_API=http://127.0.0.1:18080
WORKER_INTERVAL_MS=15000
WORKER_POWER_WATTS=0
WORKER_ELECTRICITY_BRL_KWH=0.90
WORKER_CLOUD_COST_BRL_DAY=0
AUTO_START_XMRIG=false
XMRIG_EXECUTABLE=
XMRIG_CONFIG=

# P2Pool opcional: caminho para p2pool.exe/binário já instalado pelo usuário.
P2POOL_EXE=
